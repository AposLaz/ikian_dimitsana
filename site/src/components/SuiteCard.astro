---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  description: string;
  ama: string;
  bookingLink: string;
  images: { src: string; alt: string }[];
  index: number;
  bookBtn?: string;
  callBtn?: string;
}

const { name, description, ama, bookingLink, images, index, bookBtn = 'Book on Airbnb', callBtn = 'Call & Save 10%' } = Astro.props;
const heroImage = images[0];
const galleryImages = images.slice(1, 5);
const allImages = [heroImage, ...galleryImages];
const lightboxId = `lightbox-${index}`;
const isReversed = index % 2 !== 0;
---

<article class:list={['suite-card', { 'suite-card-reversed': isReversed }]} id={`suite-${index + 1}`}>
  <div class="suite-hero">
    <button
      type="button"
      class="img-btn"
      data-lightbox={lightboxId}
      data-index="0"
      aria-label={`View ${heroImage.alt} full size`}
    >
      <Image
        src={heroImage.src}
        alt={heroImage.alt}
        width={800}
        height={500}
        loading="lazy"
        decoding="async"
        class="suite-hero-img"
      />
    </button>
  </div>

  <div class="suite-content">
    <h3 class="suite-name">{name}</h3>
    <div class="divider"></div>
    <p class="suite-description">{description}</p>
    <p class="suite-ama">AMA: {ama}</p>

    {galleryImages.length > 0 && (
      <div class="suite-gallery" role="group" aria-label={`${name} photo gallery`}>
        {galleryImages.map((img, i) => (
          <button
            type="button"
            class="img-btn"
            data-lightbox={lightboxId}
            data-index={String(i + 1)}
            aria-label={`View ${img.alt} full size`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              width={200}
              height={150}
              loading="lazy"
              decoding="async"
              class="gallery-thumb"
            />
          </button>
        ))}
      </div>
    )}

    <div class="suite-actions">
      <a
        href={bookingLink}
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${bookBtn} — ${name}`}
      >
        {bookBtn}
      </a>
      <a
        href="tel:+306973373560"
        class="btn btn-outline"
        aria-label={callBtn}
      >
        {callBtn}
      </a>
    </div>
  </div>

  <!-- Lightbox overlay -->
  <div class="lightbox" id={lightboxId} role="dialog" aria-modal="true" aria-label={`${name} image gallery`} hidden>
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" aria-label="Close gallery">&times;</button>
      <button type="button" class="lightbox-prev" aria-label="Previous image">&#8249;</button>
      <div class="lightbox-img-wrap">
        <img class="lightbox-img" src="" alt="" />
        <p class="lightbox-counter"></p>
      </div>
      <button type="button" class="lightbox-next" aria-label="Next image">&#8250;</button>
    </div>
    <script type="application/json" class="lightbox-data" set:html={JSON.stringify(allImages)} />
  </div>
</article>

<style>
  .suite-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-stone);
  }

  .suite-card-reversed {
    direction: rtl;
  }

  .suite-card-reversed > * {
    direction: ltr;
  }

  .suite-card:last-child {
    border-bottom: none;
  }

  .suite-hero {
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4/3;
  }

  .img-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .suite-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .suite-card:hover .suite-hero-img {
    transform: scale(1.03);
  }

  .suite-name {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    color: var(--color-black);
  }

  .suite-description {
    color: var(--color-text-light);
    font-size: 1rem;
    line-height: 1.8;
  }

  .suite-ama {
    font-size: 0.8rem;
    color: var(--color-text-light);
    letter-spacing: 0.05em;
    margin-top: var(--space-sm);
  }

  .suite-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .gallery-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 3px;
    transition: opacity var(--transition-fast);
  }

  .gallery-thumb:hover {
    opacity: 0.85;
  }

  .suite-actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 95vw;
    max-height: 95vh;
    width: 100%;
  }

  .lightbox-img-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
  }

  .lightbox-counter {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    margin-top: 0.75rem;
    text-align: center;
    letter-spacing: 0.1em;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    color: white;
    font-size: 2.2rem;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
    z-index: 2;
    transition: opacity 150ms ease;
  }

  .lightbox-close:hover {
    opacity: 0.7;
  }

  .lightbox-prev,
  .lightbox-next {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 2.5rem;
    cursor: pointer;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    line-height: 1;
    flex-shrink: 0;
    transition: background 150ms ease;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 768px) {
    .suite-card {
      grid-template-columns: 1fr;
    }

    .suite-card-reversed {
      direction: ltr;
    }

    .suite-gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .lightbox-prev,
    .lightbox-next {
      font-size: 1.8rem;
      padding: 0.5rem 0.75rem;
    }

    .lightbox-close {
      top: -2rem;
      font-size: 1.8rem;
    }
  }
</style>

<script>
  // Lightbox functionality — minimal, no dependencies
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.img-btn[data-lightbox]');
    
    triggers.forEach(btn => {
      btn.addEventListener('click', () => {
        const lightboxId = btn.dataset.lightbox!;
        const index = parseInt(btn.dataset.index || '0', 10);
        const lightbox = document.getElementById(lightboxId);
        if (!lightbox) return;
        openLightbox(lightbox, index);
      });
    });

    function openLightbox(lightbox: HTMLElement, startIndex: number) {
      const dataEl = lightbox.querySelector('.lightbox-data');
      if (!dataEl) return;
      const images: { src: string; alt: string }[] = JSON.parse(dataEl.textContent || '[]');
      if (images.length === 0) return;

      let current = startIndex;
      const img = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
      const counter = lightbox.querySelector<HTMLElement>('.lightbox-counter')!;
      const prevBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev')!;
      const nextBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-next')!;
      const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
      const backdrop = lightbox.querySelector<HTMLElement>('.lightbox-backdrop')!;

      function show(i: number) {
        current = ((i % images.length) + images.length) % images.length;
        img.src = images[current].src;
        img.alt = images[current].alt;
        counter.textContent = `${current + 1} / ${images.length}`;
      }

      function close() {
        lightbox.hidden = true;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKey);
      }

      function onKey(e: KeyboardEvent) {
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      }

      show(current);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);

      closeBtn.onclick = close;
      prevBtn.onclick = (e) => { e.stopPropagation(); show(current - 1); };
      nextBtn.onclick = (e) => { e.stopPropagation(); show(current + 1); };
      img.onclick = (e) => { e.stopPropagation(); };

      // Close when clicking anywhere in the lightbox except the image and nav buttons
      lightbox.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target === img || target.closest('.lightbox-prev') || target.closest('.lightbox-next')) return;
        close();
      });
    }
  });
</script>

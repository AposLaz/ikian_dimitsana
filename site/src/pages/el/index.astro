---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuiteCard from '../../components/SuiteCard.astro';
import { suiteData } from '../../i18n/translations';
import { Image } from 'astro:assets';
import { url } from '../../utils/url';

type ImgEntry = { src: string; alt: string };

function buildImages(folder: string, files: string[], featured: string, prefix: string): ImgEntry[] {
  const ordered = [featured, ...files.filter((f) => f !== featured)];
  return ordered.map((f) => {
    const slug = f
      .replace(/^ikian-dimitsana-/, '')
      .replace(/\.jpe?g$/i, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    return {
      src: url(`/images/suites/${folder}/${f}`),
      alt: `${prefix} — ${slug}`,
    };
  });
}

